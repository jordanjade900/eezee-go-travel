# Custom EE-Zee Go registration / planning / staff workspace.
# Never commit real secrets. Copy to .env.local for the local server.
OPS_STORE=sqlite
OPS_ORIGIN=http://127.0.0.1:4191
OPS_ADMIN_EMAIL=owner@eezeego.local
OPS_ADMIN_NAME=EE-Zee Go owner
# Generate each independently with node:crypto randomBytes(32).toString('hex').
OPS_ENCRYPTION_KEY=
OPS_SESSION_SECRET=
# Format generated by hashPassword in backend/security.mjs: salt:128-hex hash.
# The local server can safely bootstrap random local-only credentials.
OPS_ADMIN_PASSWORD_HASH=
# Optional absolute path to a local SQLite file. Default work/operations.sqlite.
OPS_DB_PATH=
# Production: use OPS_STORE=netlify, OPS_ORIGIN=https://eezee-go-travel.netlify.app
# and independent production secrets. NODE_ENV=production prohibits SQLite.
# No Whop, payment, email, or paid CRM integration is included.
